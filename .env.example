# Copy to .env and fill in. Never commit .env or paste keys into chat.

# Gnani (app.gnani.ai/voice) — speech-to-text + text-to-speech
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5

# Groq (console.groq.com) — understanding + translation
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Twilio WhatsApp sandbox (console.twilio.com) — optional, for the WhatsApp channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public HTTPS URL of this server (your cloudflared/ngrok tunnel). Twilio signs requests against it.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Generate both with:  .venv\Scripts\python -m app.keys
SECRET_KEY=
FERNET_KEY=

# DEMO_MODE=true prints sign-in codes in the server console instead of requiring WhatsApp delivery.
DEMO_MODE=false
# REQUIRE_LOGIN=true makes searching require phone sign-in (donor registration always does).
REQUIRE_LOGIN=false
